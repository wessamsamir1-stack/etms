# ETMS production environment. Copy to deploy/.env.prod and fill in — that file
# is gitignored and holds real secrets.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d --build
#
# Generate every secret with:  openssl rand -base64 36

# ---- Postgres (the admin role; used only by the migrate job) ----------------
POSTGRES_USER=etms_admin
POSTGRES_PASSWORD=
POSTGRES_DB=etms

# ---- Application DB roles ---------------------------------------------------
# The API connects as this RLS-enforced, non-superuser role.
APP_DB_USER=etms_app_login
APP_DB_PASSWORD=

# Cross-tenant Super-Admin role (BYPASSRLS) — also used by the notification worker.
PLATFORM_DB_USER=etms_platform_login
PLATFORM_DB_PASSWORD=

# First platform operator, created by seed-platform.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ---- Application secrets (32+ chars each; the API refuses to boot otherwise) -
JWT_SECRET=
QR_SECRET=

# Field encryption for sensitive PII (home / pickup address).
# Format: id:base64key[,id2:base64key2] — the first key is active, the rest
# decrypt only (rotation). Leave empty to store those fields in plaintext.
FIELD_ENCRYPTION_KEYS=

# ---- Web dashboard origin ---------------------------------------------------
# Exact origin, never '*' — the production guard rejects a wildcard at boot.
CORS_ORIGIN=https://admin.etms.example.com

# ---- Scaling knobs ----------------------------------------------------------
API_REPLICAS=2
PGBOUNCER_POOL_SIZE=25
PGBOUNCER_MAX_CLIENT_CONN=500
WORKER_INTERVAL_MS=2000
ETMS_TAG=latest
