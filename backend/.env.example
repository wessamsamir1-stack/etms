# ETMS backend configuration (never commit real secrets)
PORT=8080

# Also consumed by docker-compose.yml, whose api/worker services default to
# `production`. Keep this `development` for a local stack run: the guards in
# src/config.ts reject CORS_ORIGIN='*' and the default JWT/QR secrets under
# production, so the container would exit at boot.
NODE_ENV=development

# Postgres (RLS-enforced). Connect as a NON-superuser role that inherits etms_app
# so Row-Level Security applies. Leave unset to run the API with DB routes disabled.
DATABASE_URL=postgres://etms_app_login:app-dev-pass@localhost:5432/etms

# Direct-to-Postgres connection for the realtime LISTEN/NOTIFY channel (live
# tracking). Set this when DATABASE_URL points at a connection pooler in
# TRANSACTION mode — such a pooler cannot hold a session-lifetime LISTEN, so the
# stream would go silently dead. Defaults to DATABASE_URL when unset.
# LISTENER_DATABASE_URL=postgres://etms_app_login:app-dev-pass@localhost:5432/etms

# Admin connection used ONLY by the migration + create-app-role scripts (DDL).
# MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/etms
# APP_DB_USER=etms_app_login
# APP_DB_PASSWORD=app-dev-pass
# MIGRATIONS_DIR=../db/migrations   # (set to /app/migrations inside the image)

# HS256 secret used to verify API access tokens (minted at login).
JWT_SECRET=change-me-in-production

# HMAC secret for QR check-in/out tokens.
QR_SECRET=change-me-in-production

# CORS allowed origin for the web admin dashboard (docs/etms/admin-dashboard-app.html).
# Off unless set. Use '*' for local testing (Bearer-token auth, no cookies).
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# docker-compose.yml only
#
# Compose reads `backend/.env` (the compose file's own directory). Copy this
# file to `backend/.env` — it is gitignored — for a local stack run. Everything
# below has a working default in docker-compose.yml, so an empty .env still
# boots; set them to override.
# ---------------------------------------------------------------------------

# Login role the API connects as — non-superuser, so RLS is enforced.
# APP_DB_PASSWORD=app-dev-pass

# Platform (Super-Admin) BYPASSRLS role. Also used by the notification worker,
# which needs to drain the outbox across tenants.
# PLATFORM_DB_PASSWORD=platform-dev-pass
# PLATFORM_ADMIN_EMAIL=root@etms.app
# PLATFORM_ADMIN_PASSWORD=Platform0wner!

# How often the notification worker polls the outbox (ms).
# WORKER_INTERVAL_MS=2000
